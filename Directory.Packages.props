<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Roslyn (analyzers + source generator)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(MicrosoftCodeAnalysisVersion)"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisVersion)"/>
    <PackageVersion Include="ANcpLua.Roslyn.Utilities.Polyfills" Version="$(ANcpLuaRoslynUtilitiesVersion)"/>
    <PackageVersion Include="ANcpLua.Roslyn.Utilities.Sources" Version="$(ANcpLuaRoslynUtilitiesVersion)"/>
  </ItemGroup>

  <ItemGroup Label="Shipped packages">
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="$(SystemDiagnosticsDiagnosticSourceVersion)"/>
  </ItemGroup>

  <ItemGroup Label="Repository build host">
    <PackageVersion Include="Fallout.Common" Version="$(FalloutVersion)"/>
    <PackageVersion Include="DotCov.Fallout" Version="$(DotCovVersion)"/>
  </ItemGroup>

  <!-- The .NET SDK's NuGet (7.9.0) for the build host, not the 6.14.3 Fallout.Common 10.4.0 brings
       (Fallout-build/Fallout#677). Transitive pinning applies it without a direct reference. -->
  <ItemGroup Label="Build host">
    <PackageVersion Include="NuGet.Packaging" Version="$(NuGetPackagingVersion)"/>
  </ItemGroup>

  <!-- NuGet.Packaging and MSBuild in the build host (10.0.10) and
       Microsoft.CodeAnalysis.Analyzer.Testing in the tests (8.0.1) bring vulnerable
       System.Security.Cryptography builds; transitive pinning lifts both to the patched one. -->
  <ItemGroup Label="Security pins">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(SystemSecurityCryptographyVersion)"/>
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(SystemSecurityCryptographyVersion)"/>
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="OpenTelemetry" Version="1.20.0"/>
    <PackageVersion Include="ANcpLua.Roslyn.Utilities.Testing" Version="$(ANcpLuaRoslynUtilitiesVersion)"/>
  </ItemGroup>
</Project>
