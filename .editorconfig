root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json,csproj,props,targets,slnx,xml}]
indent_size = 2

[*.{md,sh,cmd}]
indent_size = 2

[*.cs]
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
