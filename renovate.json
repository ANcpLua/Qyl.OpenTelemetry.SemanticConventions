{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ANcpLua/github-settings-automation"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the OpenTelemetry semantic-conventions release pinned in registry/manifest.yaml",
      "managerFilePatterns": [
        "/(^|/)registry/manifest\\.yaml$/"
      ],
      "matchStrings": [
        "schema_url: https://opentelemetry\\.io/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"
      ],
      "depNameTemplate": "open-telemetry/semantic-conventions",
      "packageNameTemplate": "open-telemetry/semantic-conventions",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track the OpenTelemetry Weaver release pinned in Version.props",
      "managerFilePatterns": [
        "/(^|/)Version\\.props$/"
      ],
      "matchStrings": [
        "<WeaverVersion>(?<currentValue>[^<]+)</WeaverVersion>"
      ],
      "depNameTemplate": "open-telemetry/weaver",
      "packageNameTemplate": "open-telemetry/weaver",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track the same Weaver release where mise.toml installs the binary",
      "managerFilePatterns": [
        "/(^|/)mise\\.toml$/"
      ],
      "matchStrings": [
        "\"github:open-telemetry/weaver\" = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "open-telemetry/weaver",
      "packageNameTemplate": "open-telemetry/weaver",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Review and regenerate the semantic-conventions release and Weaver pin updates together. The genai branch commit is moved by hand after the pin-freshness report: a digest bump without regeneration cannot pass check-generated, so Renovate does not track it.",
      "matchFileNames": [
        "registry/manifest.yaml",
        "Version.props",
        "mise.toml"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "groupName": "semantic-conventions toolchain",
      "automerge": false
    },
    {
      "description": "The Weaver pin in mise.toml moves with the custom manager above, so mise's own manager leaves it alone",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "/weaver/"
      ],
      "enabled": false
    }
  ]
}
