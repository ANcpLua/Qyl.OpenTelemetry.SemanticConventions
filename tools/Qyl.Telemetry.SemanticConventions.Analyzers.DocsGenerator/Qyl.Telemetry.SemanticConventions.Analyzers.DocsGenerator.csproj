<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.Telemetry.SemanticConventions.Analyzers.DocsGenerator</RootNamespace>
    <AssemblyName>Qyl.Telemetry.SemanticConventions.Analyzers.DocsGenerator</AssemblyName>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The internal generator emits invariant English text and exposes read-only seams deliberately. -->
    <NoWarn>$(NoWarn);CA1050;CA1305;CA1707;CA1822;CA1859;CA2007;CS1591;IDE0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The alias prevents analyzer polyfills from colliding with net10 BCL types. -->
    <ProjectReference Include="..\..\src\Qyl.Telemetry.SemanticConventions.Analyzers\Qyl.Telemetry.SemanticConventions.Analyzers.csproj" Aliases="analyzers"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all"/>
  </ItemGroup>

</Project>
