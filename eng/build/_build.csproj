<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.Telemetry.SemanticConventions.Build</RootNamespace>
    <AssemblyName>_build</AssemblyName>

    <IsPackable>false</IsPackable>
    <!-- _build is the build-project name fallout :setup defaults to. -->
    <NoWarn>$(NoWarn);CA1050;CA1707;CA1822;CA2007;CS1591</NoWarn>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <FalloutRootDirectory>../..</FalloutRootDirectory>
    <FalloutScriptDirectory>../..</FalloutScriptDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common"/>
  </ItemGroup>

</Project>
