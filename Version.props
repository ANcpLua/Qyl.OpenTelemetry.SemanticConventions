<Project>
  <PropertyGroup Label="Central Versions">
    <!-- The registry pins live in registry/manifest.yaml and reach the build through the
         generated generated/pins.props. WeaverVersion is the one pin MSBuild owns:
         scripts/generate.sh refuses a Weaver binary of any other version, and
         scripts/check-pin-freshness.py and Renovate read it. The binary itself comes from
         mise.toml, which CI and `mise install` both install, so a Weaver bump moves both. -->
    <WeaverVersion>0.27.0</WeaverVersion>

    <!-- renovate: datasource=nuget depName=ANcpLua.Roslyn.Utilities -->
    <ANcpLuaRoslynUtilitiesVersion>2.2.46</ANcpLuaRoslynUtilitiesVersion>
    <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.CSharp -->
    <MicrosoftCodeAnalysisVersion>5.9.0</MicrosoftCodeAnalysisVersion>

    <!-- renovate: datasource=nuget depName=Fallout.Common -->
    <FalloutVersion>10.4.0</FalloutVersion>

    <!-- renovate: datasource=nuget depName=xunit.v3.mtp-v2 -->
    <XunitVersion>4.0.0</XunitVersion>
    <!-- renovate: datasource=nuget depName=AwesomeAssertions -->
    <AwesomeAssertionsVersion>9.6.0</AwesomeAssertionsVersion>

    <!-- renovate: datasource=nuget depName=NuGet.Packaging -->
    <NuGetPackagingVersion>7.9.0</NuGetPackagingVersion>
    <!-- renovate: datasource=nuget depName=System.Diagnostics.DiagnosticSource -->
    <SystemDiagnosticsDiagnosticSourceVersion>10.0.11</SystemDiagnosticsDiagnosticSourceVersion>
  </PropertyGroup>
</Project>
