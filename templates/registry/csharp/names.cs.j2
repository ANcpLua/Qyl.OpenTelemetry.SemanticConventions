{%- import "lib.j2" as lib -%}
{#-
  The telemetry names the registry knows: the ActivitySource/Meter scopes qyl constructs, the
  ActivitySource names of the pinned third-party libraries qyl subscribes to, and the
  qyl-owned Activity/DiagnosticSource event names. The producer packages construct their
  ActivitySource and Meter from these, and qyl's architecture forbids them from reading the
  incubating tier, so this file ships from the stable package.

  Scope names and vendor ActivitySource names arrive as parameters: Weaver's materialized v2
  registry flattens `registry.*` groups into the catalog and drops their group annotations, so
  scripts/generate.sh reads them out of registry/qyl/names.yaml and registry/vendor/*.yaml.
-#}
{%- set pad = "    " -%}
{%- set inner = "        " -%}
{%- set scopes = params.scope_names | split(",") | list | sort(case_sensitive=true) -%}
{%- set vendor_sources = params.vendor_activity_sources | split(",") | list | sort(case_sensitive=true) -%}
{%- set events = ctx.events | sort(case_sensitive=true) -%}
