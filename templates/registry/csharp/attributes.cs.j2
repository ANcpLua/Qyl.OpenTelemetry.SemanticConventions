{%- set rel = a.key[(root | length) + 1:] if a.key[0:(root | length) + 1] == root ~ "." else a.key -%}
{%- set id = lib.pascal(rel) -%}
{%- set isdep = true if a.deprecated else false -%}
{%- set pos = namespace(p = -1) -%}
