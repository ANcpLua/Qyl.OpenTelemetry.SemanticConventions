{%- endfor -%}
{%- if pos.p < 0 -%}
{%- set c.ids = c.ids + [id] -%}
{%- set c.keys = c.keys + [a.key] -%}
{%- set c.deps = c.deps + [isdep] -%}
{%- elif (c.deps[pos.p] and not isdep) or (c.deps[pos.p] == isdep and a.key < c.keys[pos.p]) -%}
{%- set c.keys = c.keys[:pos.p] + [a.key] + c.keys[pos.p + 1:] -%}
{%- set c.deps = c.deps[:pos.p] + [isdep] + c.deps[pos.p + 1:] -%}
{%- endif -%}
{%- endfor -%}
