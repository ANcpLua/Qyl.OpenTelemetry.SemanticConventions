{#-
  Shared macros for the C# templates.

  The markdown-to-XML-doc conversion is the contract of the shipped constant files: registry
  brief/note fields are GitHub-flavoured markdown, C# XML doc comments are parsed as XML, and a
  mismatched tag makes the compiler drop the whole comment. Every construct therefore emits
  balanced or self-closing XML only:

    paragraph break  -> a self-closing <para/> separator line
    inline code      -> <c>
    fenced code      -> a <code> block
    link             -> <a href> with balanced-parenthesis URL parsing; image -> alt text only
    GitHub alert     -> [!WARNING] becomes "Warning:"
    blockquote       -> markers stripped; a leading quote block is wrapped in <blockquote>
    GFM separator    -> dropped

  All literal text is XML-escaped. Ordinal ordering is done in the JQ filters, not here:
  MiniJinja's `sort` is case-insensitive.
-#}

{#- XML-escape. -#}
{%- macro esc(t) -%}
{{ t | replace("&", "&amp;") | replace("<", "&lt;") | replace(">", "&gt;") }}
{%- endmacro -%}

{#- PascalCase: split on `.`, `_`, `-` and space, upper-case the first character of each
    segment, keep the rest verbatim. Deliberately not Weaver's `pascal_case`, which also
    splits camelCase and lower-cases the remainder. -#}
{%- macro pascal(v) -%}
{%- set s = namespace(out = "") -%}
{%- for seg in v | replace("_", ".") | replace("-", ".") | replace(" ", ".") | split(".") -%}
{%- if (seg | length) > 0 -%}
{%- set s.out = s.out ~ (seg[0] | upper) ~ seg[1:] -%}
{%- endif -%}
{%- endfor -%}
{{ s.out }}
{%- endmacro -%}

{#- Whitespace runs collapsed to one space, then trimmed. -#}
{%- macro collapse(t) -%}
{{ t | split | join(" ") }}
{%- endmacro -%}

{#- First character upper-cased, the rest lower-cased. -#}
{%- macro capitalize_word(w) -%}
{%- if (w | length) > 0 -%}{{ (w[0] | upper) ~ (w[1:] | lower) }}{%- endif -%}
{%- endmacro -%}

{#- Index of `needle` in `hay` at or after `start`, or -1. -#}
{%- macro index_of(hay, needle, start) -%}
{%- set m = needle | length -%}
{%- set s = namespace(r = -1) -%}
{%- for k in range(start, (hay | length) - m + 1) -%}
{%- if s.r < 0 and hay[k:k + m] == needle -%}{%- set s.r = k -%}{%- endif -%}
{%- endfor -%}
{{ s.r }}
{%- endmacro -%}

{#- A GitHub alert `[!WORD]` anchored at `start`: "<end>\t<word>", or "" when absent. -#}
{%- macro parse_alert(text, start) -%}
{%- set n = text | length -%}
{%- if start + 2 < n and text[start:start + 2] == "[!" -%}
{%- set a = namespace(j = start + 2, closed = false, stop = false, word = "") -%}
{%- for k in range(start + 2, n) -%}
{%- if not a.stop -%}
{%- set c = text[k] -%}
{%- if c == "]" -%}
{%- set a.j = k + 1 -%}{%- set a.closed = true -%}{%- set a.stop = true -%}
{%- elif (c | lower) != (c | upper) or c in "0123456789_" -%}
{%- set a.word = a.word ~ c -%}
{%- else -%}
{%- set a.stop = true -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if a.closed and (a.word | length) > 0 -%}{{ a.j ~ "\t" ~ a.word }}{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- A markdown link or image body whose `[` sits at `start`. Bracketed text may nest and span
    newlines; the URL is read with balanced parentheses so inner or trailing `)` stay in the
    href instead of truncating the link. Returns "ok\t<end>\t<text>\t<url>" or "no". -#}
{%- macro parse_link(text, start) -%}
{%- set n = text | length -%}
{%- if start >= n or text[start] != "[" -%}
no
{%- else -%}
{%- set t = namespace(i = start + 1, depth = 1, body = "", closed = false, stop = false) -%}
{%- for k in range(start + 1, n) -%}
{%- if not t.stop -%}
{%- set c = text[k] -%}
{%- if c == "[" -%}
{%- set t.depth = t.depth + 1 -%}{%- set t.body = t.body ~ c -%}
{%- elif c == "]" -%}
{%- set t.depth = t.depth - 1 -%}
{%- if t.depth == 0 -%}
{%- set t.i = k + 1 -%}{%- set t.closed = true -%}{%- set t.stop = true -%}
{%- else -%}
{%- set t.body = t.body ~ c -%}
{%- endif -%}
{%- else -%}
{%- set t.body = t.body ~ c -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if (not t.closed) or t.i >= n or text[t.i] != "(" -%}
no
{%- else -%}
{%- set u = namespace(i = t.i + 1, depth = 1, url = "", closed = false, stop = false) -%}
{%- for k in range(t.i + 1, n) -%}
{%- if not u.stop -%}
{%- set c = text[k] -%}
{%- if c == "(" -%}
{%- set u.depth = u.depth + 1 -%}{%- set u.url = u.url ~ c -%}
{%- elif c == ")" -%}
{%- set u.depth = u.depth - 1 -%}
{%- if u.depth == 0 -%}
{%- set u.i = k + 1 -%}{%- set u.closed = true -%}{%- set u.stop = true -%}
{%- else -%}
{%- set u.url = u.url ~ c -%}
{%- endif -%}
{%- else -%}
{%- set u.url = u.url ~ c -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if not u.closed -%}
no
{%- else -%}
{{ "ok\t" ~ u.i ~ "\t" ~ t.body ~ "\t" ~ u.url }}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- Inline markdown (which may span newlines) to escaped XML-doc markup. -#}
{%- macro render_inline(text) -%}
{%- set n = text | length -%}
{%- set s = namespace(i = 0, out = "", done = false) -%}
{%- for _token in range(n) -%}
{%- if s.i < n -%}
{%- set ch = text[s.i] -%}
{%- set s.done = false -%}
{%- if ch == "`" -%}
{%- set b = namespace(j = s.i + 1, stop = false) -%}
{%- for k in range(s.i + 1, n) -%}
{%- if not b.stop -%}
{%- if text[k] == "`" -%}{%- set b.j = k + 1 -%}{%- else -%}{%- set b.stop = true -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- set ticks = text[s.i:b.j] -%}
{%- set close = index_of(text, ticks, b.j) | int -%}
{%- if close < 0 -%}
{%- set s.out = s.out ~ esc(ch) -%}
{%- set s.i = s.i + 1 -%}
{%- else -%}
{%- set s.out = s.out ~ "<c>" ~ esc(text[b.j:close]) ~ "</c>" -%}
{%- set s.i = close + (ticks | length) -%}
{%- endif -%}
{%- set s.done = true -%}
{%- endif -%}
{%- if (not s.done) and ch == "!" and s.i + 1 < n and text[s.i + 1] == "[" -%}
{%- set link = parse_link(text, s.i + 1) -%}
{%- if link[0:3] == "ok\t" -%}
{%- set parts = link | split("\t") -%}
{%- set s.out = s.out ~ esc(collapse(parts[2])) -%}
{%- set s.i = parts[1] | int -%}
{%- else -%}
{%- set s.out = s.out ~ "!" -%}
{%- set s.i = s.i + 1 -%}
{%- endif -%}
{%- set s.done = true -%}
{%- endif -%}
{%- if (not s.done) and ch == "[" -%}
{%- set alert = parse_alert(text, s.i) -%}
{%- if (alert | length) > 0 -%}
{%- set aparts = alert | split("\t") -%}
{%- set s.out = s.out ~ esc(capitalize_word(aparts[1]) ~ ":") -%}
{%- set s.i = aparts[0] | int -%}
{%- else -%}
{%- set link = parse_link(text, s.i) -%}
{%- if link[0:3] == "ok\t" -%}
{%- set parts = link | split("\t") -%}
{%- set s.out = s.out ~ '<a href="' ~ esc(parts[3] | trim) ~ '">' ~ esc(collapse(parts[2])) ~ "</a>" -%}
{%- set s.i = parts[1] | int -%}
{%- else -%}
{%- set s.out = s.out ~ esc(ch) -%}
{%- set s.i = s.i + 1 -%}
{%- endif -%}
{%- endif -%}
{%- set s.done = true -%}
{%- endif -%}
{%- if not s.done -%}
{%- set s.out = s.out ~ esc(ch) -%}
{%- set s.i = s.i + 1 -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ s.out }}
{%- endmacro -%}

{#- Trailing newlines removed. -#}
{%- macro trim_end_newlines(text) -%}
{%- set s = namespace(t = text, stop = false) -%}
{%- for _k in range(text | length) -%}
{%- if not s.stop -%}
{%- if (s.t | length) > 0 and s.t[-1:] == "\n" -%}{%- set s.t = s.t[:-1] -%}{%- else -%}{%- set s.stop = true -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ s.t }}
{%- endmacro -%}

{#- "yes" when the line is a GFM table separator row: only space, tab, `:`, `|` and `-`,
    with at least one `-`. -#}
{%- macro is_table_separator(line) -%}
{%- set s = namespace(ok = true, dash = false) -%}
{%- for c in line | list -%}
{%- if c == "-" -%}{%- set s.dash = true -%}
{%- elif c != " " and c != "\t" and c != ":" and c != "|" -%}{%- set s.ok = false -%}
{%- endif -%}
{%- endfor -%}
{%- if s.ok and s.dash -%}yes{%- endif -%}
{%- endmacro -%}

{#- One `^\s*>\s?` marker stripped from the front of a line. -#}
{%- macro strip_quote(line) -%}
{%- set s = namespace(i = 0, stop = false) -%}
{%- for k in range(line | length) -%}
{%- if not s.stop -%}
{%- set c = line[k] -%}
{%- if c == " " or c == "\t" -%}
{%- elif c == ">" -%}
{%- set s.i = k + 1 -%}
{%- if k + 1 < (line | length) and (line[k + 1] == " " or line[k + 1] == "\t") -%}{%- set s.i = k + 2 -%}{%- endif -%}
{%- set s.stop = true -%}
{%- else -%}
{%- set s.stop = true -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ line[s.i:] }}
{%- endmacro -%}

{#- A markdown brief/note as XML-doc content lines, `\n`-joined. Paragraphs are separated by a
    self-closing <para/> line. -#}
{%- macro render_markdown(raw) -%}
{%- set text = trim_end_newlines(raw | default("", true)) -%}
{%- if (text | length) > 0 -%}
{%- set b = namespace(blocks = [], buffer = [], fence = [], in_fence = false) -%}
{%- for line in text.split("\n") -%}
{%- if (line | trim)[0:3] == "```" -%}
{%- if not b.in_fence -%}
{%- if (b.buffer | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": false, "lines": b.buffer}] -%}
{%- set b.buffer = [] -%}
{%- endif -%}
{%- set b.in_fence = true -%}{%- set b.fence = [] -%}
{%- else -%}
{%- set b.blocks = b.blocks + [{"code": true, "lines": b.fence}] -%}
{%- set b.fence = [] -%}{%- set b.in_fence = false -%}
{%- endif -%}
{%- elif b.in_fence -%}
{%- set b.fence = b.fence + [line] -%}
{%- elif ((line | trim) | length) == 0 -%}
{%- if (b.buffer | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": false, "lines": b.buffer}] -%}
{%- set b.buffer = [] -%}
{%- endif -%}
{%- else -%}
{%- set b.buffer = b.buffer + [line] -%}
{%- endif -%}
{%- endfor -%}
{%- if b.in_fence and (b.fence | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": true, "lines": b.fence}] -%}
{%- endif -%}
{%- if (b.buffer | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": false, "lines": b.buffer}] -%}
{%- endif -%}
{%- set o = namespace(lines = [], first = true) -%}
{%- for block in b.blocks -%}
{%- set r = namespace(lines = [], skip = false) -%}
{%- if block.code -%}
{%- set r.lines = ["<code>"] -%}
{%- for line in block.lines -%}{%- set r.lines = r.lines + [esc(line)] -%}{%- endfor -%}
{%- set r.lines = r.lines + ["</code>"] -%}
{%- else -%}
{%- set k = namespace(kept = []) -%}
{%- for line in block.lines -%}
{%- if is_table_separator(line) != "yes" -%}{%- set k.kept = k.kept + [line] -%}{%- endif -%}
{%- endfor -%}
{%- if (k.kept | length) == 0 -%}
{%- set r.skip = true -%}
{%- else -%}
{%- set q = namespace(quote = true, any = false) -%}
{%- for line in k.kept -%}
{%- if ((line | trim) | length) > 0 -%}
{%- set q.any = true -%}
{%- if (line | trim)[0:1] != ">" -%}{%- set q.quote = false -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if q.quote and q.any -%}
{%- set st = namespace(lines = []) -%}
{%- for line in k.kept -%}{%- set st.lines = st.lines + [strip_quote(line)] -%}{%- endfor -%}
{%- set rendered = render_inline(st.lines | join("\n")) | split("\n") | list -%}
{%- if o.first -%}
{%- set r.lines = ["<blockquote>"] + rendered[:-1] + [rendered[-1] ~ "</blockquote>"] -%}
{%- else -%}
{%- set r.lines = rendered -%}
{%- endif -%}
{%- else -%}
{%- set r.lines = render_inline(k.kept | join("\n")) | split("\n") | list -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- if not r.skip -%}
{%- if not o.first -%}{%- set o.lines = o.lines + ["<para/>"] -%}{%- endif -%}
{%- set o.lines = o.lines + r.lines -%}
{%- set o.first = false -%}
{%- endif -%}
{%- endfor -%}
{{ o.lines | join("\n") }}
{%- endif -%}
{%- endmacro -%}

{#- A `<summary>`/`<remarks>` doc block, `body` already rendered and `\n`-joined. -#}
{%- macro doc_block(pad, tag, body) -%}
{%- set s = namespace(out = pad ~ "/// <" ~ tag ~ ">\n") -%}
{%- if (body | length) > 0 -%}
{%- for line in body.split("\n") -%}
{%- set s.out = s.out ~ pad ~ "///" ~ (" " ~ line if (line | length) > 0 else "") ~ "\n" -%}
{%- endfor -%}
{%- endif -%}
{{ s.out ~ pad ~ "/// </" ~ tag ~ ">" }}
{%- endmacro -%}

{#- The [Obsolete] message: renamed -> "Replaced by X.", obsoleted -> "Removed, no
    replacement.", anything else -> its note, or "Deprecated.". -#}
{%- macro deprecated_message(dep) -%}
{%- if dep.reason == "renamed" -%}
{{ "Replaced by " ~ dep.renamed_to ~ "." }}
{%- elif dep.reason == "obsoleted" -%}
Removed, no replacement.
{%- elif dep.note is defined and dep.note and (dep.note | length) > 0 -%}
{{ dep.note }}
{%- else -%}
Deprecated.
{%- endif -%}
{%- endmacro -%}

{#- Escaped for a C# attribute argument: newlines collapse to a space. -#}
{%- macro escape_attribute(t) -%}
{{ t | replace("\\", "\\\\") | replace('"', '\\"') | replace("\n", " ") | replace("\r", "") }}
{%- endmacro -%}

{#- The `[Obsolete]` line, or nothing. -#}
{%- macro obsolete_line(pad, dep) -%}
{%- if dep -%}
{{ pad ~ '[global::System.Obsolete("' ~ escape_attribute(deprecated_message(dep)) ~ '", false)]' }}
{%- endif -%}
{%- endmacro -%}

{#- A C# string literal. -#}
{%- macro cs_string(v) -%}
{{ '"' ~ (v | replace("\\", "\\\\") | replace('"', '\\"') | replace("\r", "\\r") | replace("\n", "\\n")) ~ '"' }}
{%- endmacro -%}

{#- The value-set members every generated `…Values` class carries after its constants:
    AllValues (every catalogued value, in the order the constants are declared) and Contains
    (ordinal membership). Fully qualified BCL names so the code needs no usings; string
    literals so referencing an [Obsolete] constant never raises CS0618. -#}
{%- macro value_set(pad, values, summary) -%}
{{ pad }}/// <summary>{{ summary }}</summary>
{{ pad }}public static global::System.Collections.Generic.IReadOnlyList<string> AllValues { get; } = {% if (values | length) == 0 %}global::System.Array.Empty<string>(){% else %}new[] { {% for v in values %}{% if not loop.first %}, {% endif %}"{{ v }}"{% endfor %} }{% endif %};
{{ pad }}/// <summary>Whether <paramref name="value"/> is a catalogued value (ordinal).</summary>
{{ pad }}public static bool Contains(string value) { foreach (var candidate in AllValues) if (string.Equals(candidate, value, global::System.StringComparison.Ordinal)) return true; return false; }
{%- endmacro -%}
