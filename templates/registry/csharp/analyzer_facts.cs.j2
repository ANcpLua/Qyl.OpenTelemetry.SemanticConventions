            if (candidate.ConstraintKey is not null
                && (!attributes.TryGetValue(candidate.ConstraintKey, out var constraintValue)
                    || !string.Equals(constraintValue, candidate.ConstraintValue, StringComparison.Ordinal)))
            {
                continue;
            }

            rule = candidate;
            return true;
        }

        rule = null;
        return false;
    }
