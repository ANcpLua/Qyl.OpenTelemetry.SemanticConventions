{% endfor %}
{{ pad }}};

{{ lib.doc_block(pad, "summary", "The keys annotated <c>qyl.token_exempt: true</c>: persisted although they contain a denied token.") }}
{{ pad }}public static global::System.Collections.Generic.IReadOnlyList<string> TokenExemptKeys { get; } = new string[]
{{ pad }}{
{% for k in policy.token_exempt %}
{{ inner }}{{ lib.cs_string(k) }},
{% endfor %}
{{ pad }}};

{{ lib.doc_block(pad, "summary", "The keys of the pinned vendor libraries (registry/vendor/), which the token rule skips.") }}
{{ pad }}public static global::System.Collections.Generic.IReadOnlyList<string> VendorKeys { get; } = new string[]
{{ pad }}{
{% for k in policy.vendor_keys %}
{{ inner }}{{ lib.cs_string(k) }},
{% endfor %}
{{ pad }}};

{{ lib.doc_block(pad, "summary", "Whether <paramref name=\"key\"/> contains one of <see cref=\"DeniedKeyTokens\"/> (ordinal, case-insensitive).") }}
{{ pad }}public static bool ContainsDeniedToken(string key)
{{ pad }}{
{{ pad }}    if (key is null) throw new global::System.ArgumentNullException(nameof(key));
{{ pad }}    foreach (var token in DeniedKeyTokens)
{{ pad }}    {
{{ pad }}        if (key.IndexOf(token, global::System.StringComparison.OrdinalIgnoreCase) >= 0) return true;
{{ pad }}    }
{{ pad }}    return false;
{{ pad }}}

{{ lib.doc_block(pad, "summary", "Whether the qyl collector persists <paramref name=\"key\"/> as an attribute.") }}
{{ pad }}public static bool IsPersisted(string key)
{{ pad }}{
{{ pad }}    if (key is null) throw new global::System.ArgumentNullException(nameof(key));
{{ pad }}    // A qyl.app. key is held to the same rule by the part after the prefix: qyl.app.user.email is user.email.
{{ pad }}    if (key.StartsWith("qyl.app.", global::System.StringComparison.Ordinal) && !IsPersistedName(key.Substring("qyl.app.".Length))) return false;
{{ pad }}    return IsPersistedName(key);
{{ pad }}}

{{ pad }}private static bool IsPersistedName(string key)
{{ pad }}{
{{ pad }}    foreach (var denied in NotPersistedKeys)
{{ pad }}    {
{{ pad }}        if (string.Equals(key, denied, global::System.StringComparison.Ordinal)) return false;
{{ pad }}        if (key.Length > denied.Length && key[denied.Length] == '.' && key.StartsWith(denied, global::System.StringComparison.Ordinal)) return false;
{{ pad }}    }
{{ pad }}    foreach (var prefix in NotPersistedPrefixes)
{{ pad }}    {
{{ pad }}        if (key.StartsWith(prefix, global::System.StringComparison.OrdinalIgnoreCase)) return false;
{{ pad }}    }
{{ pad }}    foreach (var exempt in TokenExemptKeys)
{{ pad }}    {
{{ pad }}        if (string.Equals(key, exempt, global::System.StringComparison.Ordinal)) return true;
{{ pad }}    }
{{ pad }}    foreach (var vendor in VendorKeys)
{{ pad }}    {
{{ pad }}        if (string.Equals(key, vendor, global::System.StringComparison.Ordinal)) return true;
{{ pad }}    }
{{ pad }}    return !ContainsDeniedToken(key);
{{ pad }}}
