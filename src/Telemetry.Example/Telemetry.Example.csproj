<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <!-- Self-contained demo: opt out of the repo's Central Package Management so
             its demo-only deps stay out of the shared Directory.Packages.props. -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <!-- A sample exe is not a documented shipped library; don't gate it on
             XML docs (mirrors eng/build/_build.csproj). -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Demo, not a shipped package: keep it out of the nuget-publish pack. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.8.0" />

    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time-only Roslyn generator: materialises gen_ai.* semconv constants
         and Meter factories into the partials declared in SemConv.cs. No runtime
         payload (markers are [Conditional]) so it stays AOT-clean. -->
    <ProjectReference Include="..\Qyl.OpenTelemetry.SemanticConventions.SourceGeneration\Qyl.OpenTelemetry.SemanticConventions.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

</Project>
