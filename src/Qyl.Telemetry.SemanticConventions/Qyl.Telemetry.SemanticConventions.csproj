<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions stable attribute keys, generated from the OTel registry pinned at SemConvSchemaVersion (Version.props), plus the semantic-convention definition types (MetricDefinition&lt;T&gt;, SpanDefinition&lt;T&gt;, EventDefinition, EntityDefinition) that Qyl.Telemetry.SemanticConventions.SourceGeneration emits against. Keys outside the stable surface live in the .Incubating sibling package.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;stable</PackageTags>

    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package is a consumer of the repository's own generator: the constant classes are
         projected from resolved-registry.json at build time (see SemanticConventions.cs). The
         generator never references this package; it only emits text. -->
    <ProjectReference Include="../Qyl.Telemetry.SemanticConventions.SourceGeneration/Qyl.Telemetry.SemanticConventions.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
