<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions stable surface, generated by Weaver from the qyl registry (registry/manifest.yaml) and shipped pre-built: the attribute keys, the schema URL, the qyl-owned telemetry scope and event names (Names.QylTelemetryNames), the typed Activity setter extensions, and the first-class MetricDefinition&lt;T&gt; / SpanDefinition&lt;T&gt; / EventDefinition / EntityDefinition rows. Keys outside the stable surface live in the .Incubating sibling package.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;stable</PackageTags>

    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Diagnostics.Activity, for the generated setter extensions. Part of the shared
         framework from net5.0 on; netstandard2.0 consumers need the package. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
