<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions incubating attribute keys, pre-generated by Weaver against the OTel registry pinned at SemConvSchemaVersion (Version.props). These keys are subject to breaking changes between minor versions — opt in deliberately.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;incubating</PackageTags>

    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="schemas/1.43.0.yaml"/>
    <EmbeddedResource Include="schemas/gen-ai/*.json"
                      LogicalName="Qyl.OpenTelemetry.SemanticConventions.Incubating.schemas.gen-ai.%(Filename)%(Extension)"/>
    <EmbeddedResource Include="../Qyl.OpenTelemetry.SemanticConventions.SourceGeneration/Resources/resolved-registry.json"
                      Link="registry/resolved-registry.json"
                      LogicalName="Qyl.OpenTelemetry.SemanticConventions.Incubating.registry.resolved-registry.json"/>

    <None Update="schemas/gen-ai/*.json" Pack="true" PackagePath="registry/schemas/gen-ai/"/>
    <None Include="../Qyl.OpenTelemetry.SemanticConventions.SourceGeneration/Resources/resolved-registry.json"
          Pack="true"
          PackagePath="registry/resolved-registry.json"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
