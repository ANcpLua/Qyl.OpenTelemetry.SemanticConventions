<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions incubating attribute keys, pre-generated by Weaver against the OTel registry pinned at SemConvSchemaVersion (Version.props). These keys are subject to breaking changes between minor versions — opt in deliberately.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;incubating</PackageTags>

    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="schemas/**"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
