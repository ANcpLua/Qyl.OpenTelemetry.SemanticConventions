<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn IIncrementalGenerator package. Ships the generator DLL under
    analyzers/dotnet/cs/. The marker attributes
    (SemanticConvention{Attributes,Activities,Events,Meters,Metrics}[Incubating]Attribute)
    are emitted at compile-time via RegisterPostInitializationOutput, so the
    package has no runtime library payload.

    Recovered from qyl@58e00d71~1 to preserve the 2.0.0 public contract — see
    PR description / commit body. AssemblyName is intentionally `.Generator`-
    suffixed because that is the assembly identity Roslyn analyzer hosts at
    consumer sites already loaded against 2.0.0; the PackageId stays unsuffixed
    so consumers' PackageReference rows are unchanged.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Qyl.OpenTelemetry.SemanticConventions.SourceGeneration</RootNamespace>
    <AssemblyName>Qyl.OpenTelemetry.SemanticConventions.SourceGeneration.Generator</AssemblyName>

    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Don't add lib/<tfm>/<dll> automatically — analyzer DLL is placed under
         analyzers/dotnet/cs/ via _AddGeneratorToAnalyzersPackage below. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT not supported for netstandard2.0 (Roslyn analyzer requirement). -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Self-describe the Roslyn reference; SDK name-matching injection is
         fragile under IDE LSPs. -->
    <DisableImplicitRoslynPackageReference>true</DisableImplicitRoslynPackageReference>

    <!-- RS0030: BannedApiAnalyzers fires on ANcpLua.Roslyn.Utilities.Sources polyfills (expected).
         CS1591: missing XML doc — fine for an analyzer surface.
         NU5017: lib/ is empty by design (analyzers/dotnet/cs/ has the payload). -->
    <NoWarn>$(NoWarn);RS0030;CS1591;NU5017</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>Qyl.OpenTelemetry.SemanticConventions.SourceGeneration</PackageId>
    <Description>Roslyn source generator that materialises OpenTelemetry semantic-conventions constants, descriptors, and thin helpers for user-declared partial classes. Emits stable/incubating projections for attributes, metrics, events, Meter factories, and Activity setters from the pinned OpenTelemetry semantic-conventions v1.41.0 Weaver registry.</Description>
    <PackageTags>opentelemetry;semantic-conventions;roslyn;source-generator;otel;weaver</PackageTags>
    <!-- IncludeSymbols=false: snupkg packer walks lib/, which is empty by design (see _AddGeneratorToAnalyzersPackage). -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddGeneratorToAnalyzersPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-only package (ANcpLua.Roslyn.Utilities source files compiled inline);
         PrivateAssets=all keeps consumers free of any apparent dependency.
         NB: Sources ships its own polyfill *.cs under contentFiles/.../Polyfills,
         so adding the separate Polyfills package would create CS0121 duplicates
         of CallerArgumentExpressionAttribute etc. -->
    <PackageReference Include="ANcpLua.Roslyn.Utilities.Sources" PrivateAssets="all"/>
    <!-- Microsoft.CodeAnalysis.CSharp: PrivateAssets="contentfiles;analyzers"
         (NOT "all") deliberately surfaces this as a public dependency on the
         emitted package. Satisfies NU5017's "package has dependencies or content"
         check for an otherwise analyzer-only NuGet and accurately reflects that
         consumers' Roslyn host must be at least the resolved version for the
         analyzer to load. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"
                      PrivateAssets="contentfiles;analyzers"
                      IncludeAssets="compile"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ANcpLua.Roslyn.Utilities"/>
    <Using Include="ANcpLua.Roslyn.Utilities.Models"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded resolved registry: qyl-owned projection of the full OTel
         semantic-conventions registry, emitted from scripts/templates/registry/
         resolved-registry.json.j2 pinned to semconv v1.41.0 + Weaver v0.23.0.
         The LogicalName is consumed by Extractors/RegistryLoader.cs — do not
         change without updating the loader. -->
    <EmbeddedResource Include="Resources/resolved-registry.json"
                      LogicalName="Qyl.OpenTelemetry.SemanticConventions.SourceGeneration.resolved-registry.json"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')"/>
  </ItemGroup>

  <ItemGroup>
    <!-- build/ payload: no-op .props file ensures the package has non-analyzer
         content (NU5017 satisfaction) and provides a place for any future
         downstream-defined build-time properties. -->
    <None Include="build/Qyl.OpenTelemetry.SemanticConventions.SourceGeneration.props"
          Pack="true"
          PackagePath="build/Qyl.OpenTelemetry.SemanticConventions.SourceGeneration.props"/>
  </ItemGroup>

  <Target Name="_AddGeneratorToAnalyzersPackage" DependsOnTargets="GetTargetPath">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs"/>
    </ItemGroup>
  </Target>

</Project>
