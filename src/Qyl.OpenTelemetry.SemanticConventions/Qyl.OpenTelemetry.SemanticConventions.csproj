<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions stable attribute keys, pre-generated by Weaver against the OTel registry pinned at SemConvSchemaVersion (Version.props). Keys outside the stable surface live in the .Incubating sibling package.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;stable</PackageTags>

    <IsPackable>true</IsPackable>

    <NoWarn>$(NoWarn);$(WeaverXmlDocNoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="schemas/**"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
