<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Qyl.OpenTelemetry.SemanticConventions</RootNamespace>
    <AssemblyName>Qyl.OpenTelemetry.SemanticConventions</AssemblyName>

    <PackageId>Qyl.OpenTelemetry.SemanticConventions</PackageId>
    <Description>OpenTelemetry semantic-conventions stable attribute keys. Generated by Weaver from upstream master-programmatic.yaml. Keys outside the stable surface live in the .Incubating sibling package.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;stable</PackageTags>

    <IsPackable>true</IsPackable>

    <!-- Weaver emits attribute-key XML doc references like <c>some.key</c> where
         the inner text may contain raw URLs or angle brackets; suppress the CS15xx
         band for these generated sources rather than blocking on a Weaver-template
         issue we can't fix from .NET. -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1591;CS1592;CS1658;CS1734;CS1735;CS1747</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="schemas/**"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
