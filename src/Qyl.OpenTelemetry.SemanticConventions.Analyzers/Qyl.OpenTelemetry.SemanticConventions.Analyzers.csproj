<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Qyl.OpenTelemetry.SemanticConventions.Analyzers</RootNamespace>
    <AssemblyName>Qyl.OpenTelemetry.SemanticConventions.Analyzers</AssemblyName>

    <PackageId>Qyl.OpenTelemetry.SemanticConventions.Analyzers</PackageId>
    <Description>Roslyn diagnostic analyzers + code fixes for OpenTelemetry semantic-conventions consumers. Flags deprecated attributes, schema-url omission, missing required attributes (GenAI, HTTP), and a wider band of OTel observability/instrumentation patterns at compile time.</Description>
    <PackageTags>opentelemetry;semantic-conventions;roslyn;analyzer;codefix;otel</PackageTags>

    <!-- Qyl does not consume the 48-rule analyzer surface, and only one rule has executable
         behavior tests. Stable packaging requires consumer evidence; preview packs opt in. -->
    <PackPreviewAnalyzers Condition="'$(PackPreviewAnalyzers)' == ''">false</PackPreviewAnalyzers>
    <IsPackable>$(PackPreviewAnalyzers)</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Analyzer DLL ships via the _AddAnalyzersToPackage target into analyzers/dotnet/cs,
         not lib/. The default symbol packager expects lib/ and errors NU5017 when there
         is nothing there; turn off snupkg for analyzer-style packages. -->
    <IncludeSymbols>false</IncludeSymbols>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- NU5017: analyzer packs ship via _AddAnalyzersToPackage into analyzers/dotnet/cs/
         (not lib/), so the pack target's content check fires before the custom target
         runs. The nupkg is produced correctly; the warning is spurious here.
         RS2000/RS2008 are intentionally NOT suppressed: they enforce that every public
         DiagnosticDescriptor has a corresponding row in AnalyzerReleases.{Shipped,
         Unshipped}.md. tools/Qyl.OpenTelemetry.SemanticConventions.Analyzers.DocsGenerator
         relies on that contract being live. -->
    <NoWarn>$(NoWarn);NU5017;RS1041;RS1025;RS1026;RS0030;RS1038;IDE0055;CA2249;CS1591;CS1570;CS1572;CS1573;CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OpenTelemetry.SemanticConventions.Version"
                      Value="$(SemConvSchemaVersion)"/>
  </ItemGroup>

  <ItemGroup Label="Global usings consumed by imported analyzer + codefix sources">
    <Using Include="System"/>
    <Using Include="System.Collections.Generic"/>
    <Using Include="System.Collections.Concurrent"/>
    <Using Include="System.Collections.Immutable"/>
    <Using Include="System.Composition"/>
    <Using Include="System.Diagnostics.CodeAnalysis"/>
    <Using Include="System.Linq"/>
    <Using Include="System.Threading"/>
    <Using Include="System.Threading.Tasks"/>
    <Using Include="Microsoft.CodeAnalysis"/>
    <Using Include="Microsoft.CodeAnalysis.CSharp"/>
    <Using Include="Microsoft.CodeAnalysis.CSharp.Syntax"/>
    <Using Include="Microsoft.CodeAnalysis.Diagnostics"/>
    <Using Include="Microsoft.CodeAnalysis.Operations"/>
    <Using Include="Microsoft.CodeAnalysis.CodeFixes"/>
    <Using Include="Microsoft.CodeAnalysis.CodeActions"/>
    <Using Include="ANcpLua.Roslyn.Utilities"/>
    <Using Include="ANcpLua.Roslyn.Utilities.Analyzers"/>
    <Using Include="ANcpLua.Roslyn.Utilities.Contexts"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ANcpLua.Roslyn.Utilities" PrivateAssets="all"/>
    <PackageReference Include="ANcpLua.Roslyn.Utilities.Polyfills" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Resource wiring (resx ↔ Designer + LogicalName for resolver)">
    <Compile Update="Resources.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="Resources.resx"/>
    <EmbeddedResource Update="Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" LogicalName="Qyl.OpenTelemetry.SemanticConventions.Analyzers.Resources.resources"/>
    <Compile Update="CodeFixResources.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="CodeFixResources.resx"/>
    <EmbeddedResource Update="CodeFixResources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="CodeFixResources.Designer.cs" LogicalName="Qyl.OpenTelemetry.SemanticConventions.Analyzers.CodeFixResources.resources"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
  </ItemGroup>

  <!-- Bundle the analyzer assembly + ANcpLua.Roslyn.Utilities into analyzers/dotnet/cs.
       Microsoft.CodeAnalysis.CSharp[.Workspaces] are intentionally NOT bundled — they
       are provided by every analyzer host. Polyfills is source-only. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="_AddAnalyzersToPackage" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll"          PackagePath="analyzers/dotnet/cs"/>
      <TfmSpecificPackageFile Include="$(OutputPath)ANcpLua.Roslyn.Utilities.dll" PackagePath="analyzers/dotnet/cs"/>

      <!--
        Pack the buildTransitive props that exposes $(OtelSemConvAnalysisMode) to
        consumers. NuGet auto-imports buildTransitive/{PackageId}.props on restore;
        the props file's ItemGroups switch on the property value and append the
        matching editorconfig profile to $(EditorConfigFiles). Editorconfig
        profiles live at docs/editorconfig/ (single source of truth, browsable on
        GitHub) and ship under buildTransitive/editorconfig/ inside the NuGet so
        $(MSBuildThisFileDirectory) inside the props resolves alongside them.
      -->
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)buildTransitive/$(PackageId).props"
                              PackagePath="buildTransitive/$(PackageId).props"/>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/Default.editorconfig"
                              PackagePath="buildTransitive/editorconfig/Default.editorconfig"/>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/AllRulesAsErrors.editorconfig"
                              PackagePath="buildTransitive/editorconfig/AllRulesAsErrors.editorconfig"/>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/AllRulesDisabled.editorconfig"
                              PackagePath="buildTransitive/editorconfig/AllRulesDisabled.editorconfig"/>
    </ItemGroup>
  </Target>

  <!--
    After-build drift guard. Every dotnet build of this project (and therefore every
    ./build.sh solution build) invokes the DocsGenerator twice:

      1. enforce-ids mode: verify every analyzer/codefix class name, XML doc summary, and
         DiagnosticId-const doc agrees with the runtime DiagnosticDescriptor it registers.
      2. check mode:       verify docs/Qyl.OpenTelemetry.SemanticConventions.Analyzers.md
                           and the editorconfig profiles under docs/editorconfig/ match
                           what the generator would emit now.

    Both run as exec calls into the DocsGenerator project; nested dotnet runs are
    cached by the SDK so the cost on a clean build is one nested compile, after which
    each invocation is sub-second.

    Opt out with -p:SkipAnalyzerConsistencyCheck=true during inner-loop iteration.
    CI must leave it on.
  -->
  <Target Name="_VerifyAnalyzerConsistency"
          AfterTargets="Build"
          Condition="'$(SkipAnalyzerConsistencyCheck)' != 'true' AND '$(_QylInsideConsistencyCheck)' != 'true'">
    <PropertyGroup>
      <_DocsGenProject>$(MSBuildThisFileDirectory)../../tools/Qyl.OpenTelemetry.SemanticConventions.Analyzers.DocsGenerator/Qyl.OpenTelemetry.SemanticConventions.Analyzers.DocsGenerator.csproj</_DocsGenProject>
    </PropertyGroup>
    <!-- _QylInsideConsistencyCheck breaks the AfterBuild recursion: the nested
         `dotnet run` rebuilds the DocsGenerator, which transitively re-evaluates
         this analyzer csproj. Without the sentinel, AfterBuild fires inside the
         nested build and detonates into hundreds of duplicated errors. -->
    <Exec Command="dotnet run --project &quot;$(_DocsGenProject)&quot; --configuration $(Configuration) -- --enforce-ids"
          WorkingDirectory="$(MSBuildThisFileDirectory)../.."
          EnvironmentVariables="_QylInsideConsistencyCheck=true"/>
    <Exec Command="dotnet run --project &quot;$(_DocsGenProject)&quot; --configuration $(Configuration) -- --check"
          WorkingDirectory="$(MSBuildThisFileDirectory)../.."
          EnvironmentVariables="_QylInsideConsistencyCheck=true"/>
  </Target>

  <Target Name="_RequirePreviewAnalyzerVersion"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true' AND !$([System.String]::Copy('$(PackageVersion)').Contains('-'))">
    <Error Text="The analyzer package is preview-only. Use a prerelease PackageVersion while PackPreviewAnalyzers=true."/>
  </Target>

</Project>
