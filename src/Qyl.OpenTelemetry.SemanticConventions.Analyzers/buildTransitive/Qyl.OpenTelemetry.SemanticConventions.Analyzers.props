<Project>

  <!--
    Severity-profile knob for consumers of Qyl.OpenTelemetry.SemanticConventions.Analyzers.
    Set $(OtelSemConvAnalysisMode) in the consuming csproj to one of:

      Default      Every QYL rule at its descriptor-declared default severity.
                   Useful when an ambient (.editorconfig / Directory.Build.props /
                   parent SDK) config has tightened severities and you want this
                   band reset to the analyzer's per-rule defaults.

      AllAsErrors  Every QYL rule promoted to error. Use for strict CI.

      Disabled     Every QYL rule silenced.

    Unset = no editorconfig injection; the analyzer's per-rule descriptor severities
    apply, and any consumer-side editorconfig stays authoritative.

    Naming is intentionally NOT bare <AnalysisMode> — that property is owned by
    Microsoft.CodeAnalysis.NetAnalyzers and clashing would force consumers into
    one-or-the-other choices. The OtelSemConv* prefix matches the
    build_property.OtelSemConv* runtime properties this analyzer already reads.

    The editorconfig profiles below are emitted by
    tools/Qyl.OpenTelemetry.SemanticConventions.Analyzers.DocsGenerator and packed
    into this NuGet alongside the .dll. Regenerate with `./build.sh GenerateDocs`.
  -->

  <ItemGroup Condition=" '$(OtelSemConvAnalysisMode)' == 'Default' ">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)editorconfig/Default.editorconfig" />
  </ItemGroup>

  <ItemGroup Condition=" '$(OtelSemConvAnalysisMode)' == 'AllAsErrors' ">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)editorconfig/AllRulesAsErrors.editorconfig" />
  </ItemGroup>

  <ItemGroup Condition=" '$(OtelSemConvAnalysisMode)' == 'Disabled' ">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)editorconfig/AllRulesDisabled.editorconfig" />
  </ItemGroup>

</Project>
