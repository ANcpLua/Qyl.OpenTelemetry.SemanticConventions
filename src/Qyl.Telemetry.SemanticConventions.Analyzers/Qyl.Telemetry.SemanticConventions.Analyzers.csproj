<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Qyl.Telemetry.SemanticConventions.Analyzers</RootNamespace>
    <AssemblyName>Qyl.Telemetry.SemanticConventions.Analyzers</AssemblyName>

    <PackageId>Qyl.Telemetry.SemanticConventions.Analyzers</PackageId>
    <Description>Roslyn diagnostic analyzers + code fixes for OpenTelemetry semantic-conventions consumers. Flags deprecated attributes, schema-url omission, missing required attributes (GenAI, HTTP), and a wider band of OTel observability/instrumentation patterns at compile time.</Description>
    <PackageTags>opentelemetry;semantic-conventions;roslyn;analyzer;codefix;otel</PackageTags>

    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeSymbols>false</IncludeSymbols>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- NU5017 is spurious for analyzer-only packages; RS2000/RS2008 remain active for release-manifest coverage. -->
    <NoWarn>$(NoWarn);NU5017;RS1041;RS1025;RS1026;RS0030;RS1038;IDE0055;CA2249</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OpenTelemetry.SemanticConventions.Version"
                      Value="$(SemConvSchemaVersion)"/>
  </ItemGroup>

  <ItemGroup Label="Global usings consumed by imported analyzer + codefix sources">
    <Using Include="System"/>
    <Using Include="System.Collections.Generic"/>
    <Using Include="System.Collections.Concurrent"/>
    <Using Include="System.Collections.Immutable"/>
    <Using Include="System.Composition"/>
    <Using Include="System.Diagnostics.CodeAnalysis"/>
    <Using Include="System.Linq"/>
    <Using Include="System.Threading"/>
    <Using Include="System.Threading.Tasks"/>
    <Using Include="Microsoft.CodeAnalysis"/>
    <Using Include="Microsoft.CodeAnalysis.CSharp"/>
    <Using Include="Microsoft.CodeAnalysis.CSharp.Syntax"/>
    <Using Include="Microsoft.CodeAnalysis.Diagnostics"/>
    <Using Include="Microsoft.CodeAnalysis.Operations"/>
    <Using Include="Microsoft.CodeAnalysis.CodeFixes"/>
    <Using Include="Microsoft.CodeAnalysis.CodeActions"/>
    <Using Include="ANcpLua.Roslyn.Utilities"/>
    <Using Include="ANcpLua.Roslyn.Utilities.Analyzers"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Sources, not the binary: an analyzer package that ships ANcpLua.Roslyn.Utilities.dll collides in the
         compiler with any other analyzer package shipping a different version of the same assembly
         (ANcpLua.Analyzers 2.1.2 carries 2.2.44 and every rule here then fails to load with CS8032).
         The Sources package already includes its polyfills; adding Polyfills separately duplicates types. -->
    <PackageReference Include="ANcpLua.Roslyn.Utilities.Sources" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Resource wiring (resx ↔ Designer + LogicalName for resolver)">
    <Compile Update="Resources.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="Resources.resx"/>
    <EmbeddedResource Update="Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" LogicalName="Qyl.Telemetry.SemanticConventions.Analyzers.Resources.resources"/>
    <Compile Update="CodeFixResources.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="CodeFixResources.resx"/>
    <EmbeddedResource Update="CodeFixResources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="CodeFixResources.Designer.cs" LogicalName="Qyl.Telemetry.SemanticConventions.Analyzers.CodeFixResources.resources"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
  </ItemGroup>

  <!-- Compiler assemblies come from the analyzer host; only runtime dependencies are bundled. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="_AddAnalyzersToPackage" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll"          PackagePath="analyzers/dotnet/cs"/>

      <!-- Ship generated severity profiles beside the props file that imports them. -->
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)buildTransitive/$(PackageId).props"
                              PackagePath="buildTransitive/$(PackageId).props"/>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/Default.editorconfig"
                              PackagePath="buildTransitive/editorconfig/Default.editorconfig"/>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/AllRulesAsErrors.editorconfig"
                              PackagePath="buildTransitive/editorconfig/AllRulesAsErrors.editorconfig"/>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/AllRulesDisabled.editorconfig"
                              PackagePath="buildTransitive/editorconfig/AllRulesDisabled.editorconfig"/>
    </ItemGroup>
  </Target>

  <!-- Keep diagnostic IDs and generated documentation synchronized on every normal build. -->
  <Target Name="_VerifyAnalyzerConsistency"
          AfterTargets="Build"
          Condition="'$(_QylInsideConsistencyCheck)' != 'true'">
    <PropertyGroup>
      <_DocsGenProject>$(MSBuildThisFileDirectory)../../tools/Qyl.Telemetry.SemanticConventions.Analyzers.DocsGenerator/Qyl.Telemetry.SemanticConventions.Analyzers.DocsGenerator.csproj</_DocsGenProject>
    </PropertyGroup>
    <!-- The sentinel prevents the nested DocsGenerator build from re-entering this target. -->
    <Exec Command="dotnet run --project &quot;$(_DocsGenProject)&quot; --configuration $(Configuration) -- --enforce-ids"
          WorkingDirectory="$(MSBuildThisFileDirectory)../.."
          EnvironmentVariables="_QylInsideConsistencyCheck=true"/>
    <Exec Command="dotnet run --project &quot;$(_DocsGenProject)&quot; --configuration $(Configuration) -- --check"
          WorkingDirectory="$(MSBuildThisFileDirectory)../.."
          EnvironmentVariables="_QylInsideConsistencyCheck=true"/>
  </Target>

</Project>
