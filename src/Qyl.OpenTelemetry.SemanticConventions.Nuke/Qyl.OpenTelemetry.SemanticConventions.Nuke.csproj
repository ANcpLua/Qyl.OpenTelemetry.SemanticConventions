<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Nuke.Common 10.x ships only a net10.0 assembly, so consumers (build hosts) need a
      modern .NET SDK. Targeting net10.0 here aligns with the SDK pinned in global.json.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.OpenTelemetry.SemanticConventions.Nuke</RootNamespace>
    <AssemblyName>Qyl.OpenTelemetry.SemanticConventions.Nuke</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Qyl.OpenTelemetry.SemanticConventions.Nuke</PackageId>
    <Title>Qyl.OpenTelemetry.SemanticConventions.Nuke</Title>
    <Description>
      Nuke build component for the Qyl OpenTelemetry semantic-conventions toolchain.
      Exposes IUpstreamConventions (Weaver-based generator pipeline, lockstep verification) and
      IDomainConventionsApi (downstream TypeSpec API pipeline) component interfaces, plus the
      LockstepPolicy helper for {semconv}-{n} version-suffix parsing. The same pipeline this
      monorepo's eng/build/ consumes to regenerate its own attribute packages — true dogfood.
    </Description>
    <PackageTags>nuke;build;opentelemetry;semantic-conventions;weaver;typespec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common"/>
  </ItemGroup>

  <!--
    Transitive security overrides. Nuke.Common 10.1.0 pulls vulnerable transitive
    versions of these packages; pinned to patched releases via CPM so NuGetAudit
    (on by default in .NET 10) does not flag the package or consumer builds with
    TreatWarningsAsErrors enabled.
      - NU1901: NuGet.Packaging <7.3.1   (GHSA-g4vj-cjjj-v7hg)
      - NU1903: System.Security.Cryptography.Xml <10.0.7
                (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf)
    Revisit when Nuke.Common ships an update that bumps these transitively.
  -->
  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" PrivateAssets="all"/>
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
