<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions incubating attribute keys, pre-generated by Weaver against the OTel registry pinned at SemConvSchemaVersion (Version.props). These keys are subject to breaking changes between minor versions — opt in deliberately.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;incubating</PackageTags>

    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="schemas/gen-ai/*.json"
                      LogicalName="Qyl.Telemetry.SemanticConventions.Incubating.schemas.gen-ai.%(Filename)%(Extension)"/>
    <EmbeddedResource Include="../Qyl.Telemetry.SemanticConventions.SourceGeneration/Resources/resolved-registry.json"
                      Link="registry/resolved-registry.json"
                      LogicalName="Qyl.Telemetry.SemanticConventions.Incubating.registry.resolved-registry.json"/>

    <!-- None Include, not Update: the default None glob excludes @(EmbeddedResource),
         so these files never exist as None items to update. -->
    <None Include="schemas/gen-ai/*.json" Pack="true" PackagePath="registry/schemas/gen-ai/"/>
    <None Include="../Qyl.Telemetry.SemanticConventions.SourceGeneration/Resources/resolved-registry.json"
          Pack="true"
          PackagePath="registry/resolved-registry.json"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The package is a consumer of the repository's own generator: the constant classes are
         projected from resolved-registry.json at build time (see SemanticConventions.cs). The
         generator never references this package; it only emits text. -->
    <ProjectReference Include="../Qyl.Telemetry.SemanticConventions.SourceGeneration/Qyl.Telemetry.SemanticConventions.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
