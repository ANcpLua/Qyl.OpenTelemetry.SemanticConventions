<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

    <Description>OpenTelemetry semantic-conventions incubating surface, generated by Weaver from the qyl registry (registry/manifest.yaml) and shipped pre-built: every stability tier of the attribute keys, the typed Activity setter extensions, the first-class metric/span/event/entity definitions, the qyl-owned instrument names, and the collector's attribute mapping table. These keys are subject to breaking changes between minor versions — opt in deliberately.</Description>
    <PackageTags>opentelemetry;semantic-conventions;otel;attributes;incubating</PackageTags>

    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The definition types (MetricDefinition&lt;T&gt;, Stability, Deprecation, AttributeRef, …)
         that the generated rows are typed against live in the stable package. -->
    <ProjectReference Include="../Qyl.Telemetry.SemanticConventions/Qyl.Telemetry.SemanticConventions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
